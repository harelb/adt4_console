<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adt4_console</name>
  <version>0.1.0</version>
  <description>ADT4 web console: FastAPI base-station server and browser UI (fleet, launch, maps, 3D scene graph, planning).</description>
  <maintainer email="harelb@mit.edu">Harel Biggie</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>omniplanner_msgs</exec_depend>
  <exec_depend>robot_executor_msgs</exec_depend>
  <exec_depend>ros_system_monitor_msgs</exec_depend>
  <exec_depend>heracles_ros_interfaces</exec_depend>
  <exec_depend>nlu_interface_rviz</exec_depend>
  <exec_depend>dcist_launch_system</exec_depend>
  <exec_depend>dcist_launch_system_msgs</exec_depend>
  <exec_depend>spark_dsg</exec_depend>
  <exec_depend>heracles</exec_depend>
  <!-- optional (features are off without them): omniplanner (dsg_pddl, GRSTAPS-X),
       heracles_agents (scene edit tools), fleetlink (live robot link) -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
